# Bot Harbor — environment for the Cortex NAS stack.
#
#   cp .env.example .env
#   # fill in the blanks, then:
#   docker compose up -d
#
# .env is gitignored. Everything in it is a secret.

# ---------------------------------------------------------------------------
# PostgreSQL (replaced Azure SQL)
# ---------------------------------------------------------------------------
POSTGRES_DB=botharbor
POSTGRES_USER=botharbor
# Generate one:  openssl rand -base64 32
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# Tailscale tunnel
# ---------------------------------------------------------------------------
# Reusable, ephemeral-OFF auth key from https://login.tailscale.com/admin/settings/keys
# Tag it so the node is identifiable, e.g. tag:container.
TS_AUTHKEY=
# The dashboard ends up at https://<TS_HOSTNAME>.<your-tailnet>.ts.net
TS_HOSTNAME=bot-harbor
# Extra `tailscale up` flags, e.g. --advertise-tags=tag:container
TS_EXTRA_ARGS=

# ---------------------------------------------------------------------------
# First operator account
# ---------------------------------------------------------------------------
# Bot Harbor has no sign-up page, so an empty database needs this to be reachable.
# After you log in and change the password, blank BOTHARBOR_ADMIN_PASSWORD and
# `docker compose up -d` again.
BOTHARBOR_ADMIN_EMAIL=
BOTHARBOR_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Cortex, the NAS
# ---------------------------------------------------------------------------
# Where the bots run. Containers, images and the whole Stats page read from here.
# The account must be in the `docker` and `systemd-journal` groups -- see deploy/README.md.
NAS_HOST=192.168.1.167
NAS_USERNAME=
NAS_PASSWORD=
# Filesystem the Stats page reports on. /volume1 is the storage pool; / is a small OS overlay.
NAS_DISK_PATH=/volume1

# ---------------------------------------------------------------------------
# Ollama, which stays on the droplet
# ---------------------------------------------------------------------------
# The droplet's TAILNET address, not its public IP: Ollama has no authentication and is
# bound to the droplet's loopback, so the tailnet is the only route to it.
OLLAMA_HOST=
OLLAMA_PORT=11434

# ---------------------------------------------------------------------------
# DigitalOcean droplet: Manage Droplet page and the Ollama controls only
# ---------------------------------------------------------------------------
DIGITALOCEAN_TOKEN=
DROPLET_ID=
DROPLET_HOST=
DROPLET_USERNAME=
DROPLET_PASSWORD=

# ---------------------------------------------------------------------------
# Cloudflare Tunnel (optional)
# ---------------------------------------------------------------------------
# Only needed for the `cloudflare` profile. Token from the tunnel's Overview tab in the
# Cloudflare dashboard. Serves botharbor.horizonstack.app, with Cloudflare Access in front.
CLOUDFLARE_TUNNEL_TOKEN=

# ---------------------------------------------------------------------------
# Image
# ---------------------------------------------------------------------------
# Override to pin a tag, or point at a locally built image.
BOTHARBOR_IMAGE=kalebg08/botharbor:latest
