# Bot Harbor — environment for the Cortex NAS stack.
#
#   cp .env.example .env
#   # fill in the blanks, then:
#   docker compose up -d
#
# .env is gitignored. Everything in it is a secret.

# ---------------------------------------------------------------------------
# PostgreSQL (replaced Azure SQL)
# ---------------------------------------------------------------------------
POSTGRES_DB=botharbor
POSTGRES_USER=botharbor
# Generate one:  openssl rand -base64 32
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# Tailscale tunnel
# ---------------------------------------------------------------------------
# Reusable, ephemeral-OFF auth key from https://login.tailscale.com/admin/settings/keys
# Tag it so the node is identifiable, e.g. tag:container.
TS_AUTHKEY=
# The dashboard ends up at https://<TS_HOSTNAME>.<your-tailnet>.ts.net
TS_HOSTNAME=bot-harbor
# Extra `tailscale up` flags, e.g. --advertise-tags=tag:container
TS_EXTRA_ARGS=

# ---------------------------------------------------------------------------
# First operator account
# ---------------------------------------------------------------------------
# Bot Harbor has no sign-up page, so an empty database needs this to be reachable.
# After you log in and change the password, blank BOTHARBOR_ADMIN_PASSWORD and
# `docker compose up -d` again.
BOTHARBOR_ADMIN_EMAIL=
BOTHARBOR_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# DigitalOcean droplet that actually runs the bots
# ---------------------------------------------------------------------------
DIGITALOCEAN_TOKEN=
DROPLET_ID=
DROPLET_HOST=
DROPLET_USERNAME=
DROPLET_PASSWORD=

# ---------------------------------------------------------------------------
# Image
# ---------------------------------------------------------------------------
# Override to pin a tag, or point at a locally built image.
BOTHARBOR_IMAGE=kalebg08/botharbor:latest
