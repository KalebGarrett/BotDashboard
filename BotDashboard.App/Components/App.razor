<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <base href="/"/>
    @* Stylesheets go through @Assets so MapStaticAssets fingerprints them. Without it the
       filename never changes, so a browser or CDN that cached the old file keeps serving it
       after a deploy -- which is exactly how a CSS change can appear not to have shipped. *@
    <link rel="stylesheet" href="@Assets["bootstrap/bootstrap.min.css"]"/>
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" rel="stylesheet" />
    <link href="_content/MudBlazor/MudBlazor.min.css?v=@Metadata.Version" rel="stylesheet" />
    <link rel="stylesheet" href="@Assets["app.css"]"/>
    <link rel="stylesheet" href="@Assets["home.css"]"/>
    <link rel="stylesheet" href="@Assets["command.css"]"/>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">
    <meta name="msapplication-TileColor" content="#02194C">
    @* Dark chrome so the browser UI and form controls match the app instead of defaulting light. *@
    <meta name="theme-color" content="#070B1E">
    <meta name="color-scheme" content="dark">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <HeadOutlet @rendermode="RenderModeForPage"/>
</head>

<body>
<Routes @rendermode="RenderModeForPage" />
<script src="_framework/blazor.web.js"></script>
<script src="_content/MudBlazor/MudBlazor.min.js?v=@(Metadata.Version)"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

        // These pages take HttpContext as a cascading parameter, which exists only during
        // static server rendering. Rendered interactively it is null, OnInitializedAsync
        // throws, the circuit dies and the browser reloads -- an endless refresh loop.
    private IComponentRenderMode? RenderModeForPage => 
        HttpContext.Request.Path.StartsWithSegments("/manage/password") 
        || HttpContext.Request.Path.StartsWithSegments("/manage/setpassword")
        || HttpContext.Request.Path.StartsWithSegments("/manage/email")
        ? null
        : InteractiveServer;
}