@page "/commands"
@using BotDashboard.App.Constants
@using BotDashboard.Models
@using MudBlazor
@inject ISnackbar Snackbar

<PageTitle>Commands</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="row gy-3">
            <div class="col-md-6 d-flex flex-column">
                <div class="col-md-12">
                    <h2 class="bh-section-title h4">
                        <i class="bi bi-command"></i>
                        Commands
                    </h2>
                    <div class="main-site-card">
                        <div class="p-4">
                            <div class="d-flex align-items-center gap-3 mb-4">
                                <div class="bh-container-logo">
                                    <img src="imgs/Docker Logo.png" alt="Docker"/>
                                </div>
                                <div>
                                    <div class="fw-bold">Docker fleet</div>
                                    <div class="bh-muted" style="font-size: 0.8rem;">
                                        Acting on @Containers.Count running container@(Containers.Count == 1 ? "" : "s") on Cortex
                                    </div>
                                </div>
                            </div>

                            <div class="bh-command-section">Fleet</div>
                            <div class="d-flex flex-wrap gap-2 mb-4">
                                <MudButton Disabled="Locked" Color="Color.Primary" Variant="Variant.Filled"
                                           StartIcon="@Icons.Material.Filled.StopCircle"
                                           OnClick="StopAllContainers">
                                    Stop All
                                </MudButton>
                                <MudButton Disabled="Locked" Color="Color.Primary" Variant="Variant.Filled"
                                           StartIcon="@Icons.Material.Filled.RestartAlt"
                                           OnClick="RestartAllContainers">
                                    Restart All
                                </MudButton>
                            </div>

                            @* The same sections as the dashboard, since they answer the same
                               question: which container do I want, and what kind is it. *@
                            @foreach (var group in LaunchGroups)
                            {
                                <div class="bh-command-section">@group.Heading</div>
                                <div class="d-flex flex-wrap gap-2 mb-4">
                                    @* Start only. Restart and stop already live on each card under
                                       "Containers Running", and a MudButtonGroup wrapping a
                                       tooltipped icon button here put enough extra markup between
                                       the server's render tree and the browser's DOM to crash the
                                       circuit with "insertBefore of null". *@
                                    @foreach (var container in CortexContainers.In(group.Group))
                                    {
                                        <MudButton Disabled="Locked" Color="@group.Colour" Variant="Variant.Filled"
                                                   StartIcon="@Icons.Material.Filled.PlayArrow"
                                                   OnClick="() => StartContainer(container)">
                                            @container.Display
                                        </MudButton>
                                    }
                                </div>
                            }

                            <div class="bh-command-section">Pull images</div>
                            <div class="d-flex flex-wrap gap-2 mb-4">
                                @foreach (var container in CortexContainers.Pullable)
                                {
                                    <MudButton Disabled="Locked" Color="Color.Primary" Variant="Variant.Outlined"
                                               Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.CloudDownload"
                                               OnClick="() => PullImage(container.Image)">
                                        @container.Display
                                    </MudButton>
                                }
                            </div>

                            @* Both listing actions live here. "Refresh Containers" used to sit up
                               in Fleet as well, so the card offered the same command twice under
                               two names. *@
                            <div class="bh-command-section">Inspect</div>
                            <div class="d-flex flex-wrap gap-2">
                                <MudButton Disabled="Locked" Color="Color.Primary" Variant="Variant.Outlined"
                                           StartIcon="@Icons.Material.Filled.Layers"
                                           OnClick="() => ListImages()">
                                    List Images
                                </MudButton>
                                <MudButton Disabled="Locked" Color="Color.Primary" Variant="Variant.Outlined"
                                           StartIcon="@Icons.Material.Filled.ViewList"
                                           OnClick="() => ListContainers()">
                                    List Containers
                                </MudButton>
                            </div>

                            @if (Locked)
                            {
                                <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mt-4" Rounded="true"/>
                            }
                        </div>
                    </div>
                    <div class="col-md-12 mt-4">
                        <h2 class="text-white font-weight-bold fw-bold">
                            <i class="bi bi-tsunami"></i>
                            Images
                        </h2>
                        <div class="card main-site-card">
                            <div class="position-relative">
                                <div class="card-body m-4">
                                    <div class="table-responsive">
                                        <table
                                            class="table table-dark table-striped table-hover table-bordered table-active image-table-corner table">
                                            <thead>
                                            <tr>
                                                @foreach (var heading in Headings)
                                                {
                                                    <th>@heading</th>
                                                }
                                            </tr>
                                            </thead>
                                            <tbody>
                                            @foreach (var dockerImage in DockerImages)
                                            {
                                                <tr>

                                                    <td>@dockerImage.Repository</td>
                                                    <td>@dockerImage.Tag</td>
                                                    <td>@dockerImage.ImageId</td>
                                                    <td>@dockerImage.Created</td>
                                                    <td>@dockerImage.Size</td>
                                                    <td>
                                                        <MudIconButton Disabled="Locked"
                                                                       Icon="@Icons.Material.Filled.Delete"
                                                                       Color="Color.Error"
                                                                       OnClick="() => RemoveImage(dockerImage.ImageId)"></MudIconButton>
                                                    </td>
                                                </tr>
                                            }
                                            </tbody>
                                        </table>
                                        @if (DockerImages.Count == 0)
                                        {
                                            <p class="text-white">There are no images currently available...</p>
                                        }
                                    </div>
                                    <p class="text-white">Last Fetched: @ImageFetchTime</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-12 mt-4">
                        <h2 class="text-white font-weight-bold fw-bold">
                            <i class="bi bi-cpu"></i>
                            Ollama
                        </h2>
                        <div class="card main-site-card">
                            <div class="position-relative">
                                <div class="card-body text-center">
                                    <div class="container justify-content-center">
                                        <p class="text-white-50 small mb-3">
                                            Powers Jam Junction's song recommender. Runs as a systemd
                                            service on the DigitalOcean droplet, bound to 127.0.0.1:11434.
                                            Cortex reaches it over the tailnet.
                                        </p>

                                        @if (OllamaHealth != null)
                                        {
                                            <div class="bh-stat-row mb-3">
                                                <div class="bh-stat">
                                                    <span class="bh-stat__label">Service</span>
                                                    <span class="bh-stat__value" style="font-size: 1rem;">
                                                        <span class="bh-status @(OllamaHealth.ServiceActive ? "bh-status--up" : "bh-status--down")"></span>
                                                        @OllamaHealth.ServiceState
                                                    </span>
                                                </div>
                                                <div class="bh-stat">
                                                    <span class="bh-stat__label">Cortex &rarr; Ollama</span>
                                                    <span class="bh-stat__value" style="font-size: 1rem;">
                                                        <span class="bh-status @(OllamaHealth.Reachable ? "bh-status--up" : "bh-status--down")"></span>
                                                        @(OllamaHealth.Reachable ? "connected" : "no route")
                                                    </span>
                                                </div>
                                                <div class="bh-stat">
                                                    <span class="bh-stat__label">Latency</span>
                                                    <span class="bh-stat__value bh-stat__value--accent" style="font-size: 1rem;">
                                                        @(OllamaHealth.Reachable ? $"{OllamaHealth.LatencyMs} ms" : "-")
                                                    </span>
                                                </div>
                                                <div class="bh-stat">
                                                    <span class="bh-stat__label">Models</span>
                                                    <span class="bh-stat__value" style="font-size: 1rem;">
                                                        @(OllamaHealth.Models.Count > 0
                                                            ? string.Join(", ", OllamaHealth.Models)
                                                            : "-")
                                                    </span>
                                                </div>
                                            </div>

                                            <p class="text-white-50 small mb-2">
                                                Endpoint: <code>@OllamaHealth.Endpoint</code>
                                            </p>

                                            @if (!string.IsNullOrWhiteSpace(OllamaHealth.Error))
                                            {
                                                <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
                                                    @OllamaHealth.Error
                                                </MudAlert>
                                            }

                                            <p class="bh-timestamp mb-3">Last checked: @OllamaHealthFetchTime</p>
                                        }
                                        <div class="row g-2">
                                            <div class="col-md-4">
                                                <MudButton Disabled="Locked" FullWidth="true"
                                                           Color="Color.Info" Variant="Variant.Filled"
                                                           Size="Size.Large" OnClick="() => CheckOllamaHealth()">
                                                    Check Connection
                                                </MudButton>
                                            </div>
                                            <div class="col-md-4">
                                                <MudButton Disabled="Locked" FullWidth="true"
                                                           Color="Color.Primary" Variant="Variant.Filled"
                                                           Size="Size.Large" OnClick="OllamaStatus">
                                                    Status
                                                </MudButton>
                                            </div>
                                            <div class="col-md-4">
                                                <MudButton Disabled="Locked" FullWidth="true"
                                                           Color="Color.Primary" Variant="Variant.Filled"
                                                           Size="Size.Large" OnClick="OllamaApiHealth">
                                                    API Health
                                                </MudButton>
                                            </div>
                                            <div class="col-md-4">
                                                <MudButton Disabled="Locked" FullWidth="true"
                                                           Color="Color.Primary" Variant="Variant.Filled"
                                                           Size="Size.Large" OnClick="OllamaMemoryUsage">
                                                    Memory
                                                </MudButton>
                                            </div>
                                            <div class="col-md-4">
                                                <MudButton Disabled="Locked" FullWidth="true"
                                                           Color="Color.Primary" Variant="Variant.Filled"
                                                           Size="Size.Large" OnClick="OllamaListModels">
                                                    List Models
                                                </MudButton>
                                            </div>
                                            <div class="col-md-4">
                                                <MudButton Disabled="Locked" FullWidth="true"
                                                           Color="Color.Primary" Variant="Variant.Filled"
                                                           Size="Size.Large" OnClick="OllamaRunningModels">
                                                    Loaded Models
                                                </MudButton>
                                            </div>
                                            <div class="col-md-4">
                                                <MudButton Disabled="Locked" FullWidth="true"
                                                           Color="Color.Primary" Variant="Variant.Filled"
                                                           Size="Size.Large"
                                                           OnClick="() => OllamaPullModel(OllamaModel.Llama32_1B)">
                                                    Pull @OllamaModel.Llama32_1B
                                                </MudButton>
                                            </div>
                                            <div class="col-md-4">
                                                <MudButton Disabled="Locked" FullWidth="true"
                                                           Color="Color.Success" Variant="Variant.Filled"
                                                           Size="Size.Large" OnClick="OllamaStart">
                                                    Start
                                                </MudButton>
                                            </div>
                                            <div class="col-md-4">
                                                <MudButton Disabled="Locked" FullWidth="true"
                                                           Color="Color.Warning" Variant="Variant.Filled"
                                                           Size="Size.Large" OnClick="OllamaRestart">
                                                    Restart
                                                </MudButton>
                                            </div>
                                            <div class="col-md-4">
                                                <MudButton Disabled="Locked" FullWidth="true"
                                                           Color="Color.Error" Variant="Variant.Filled"
                                                           Size="Size.Large" OnClick="OllamaStop">
                                                    Stop
                                                </MudButton>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6 d-flex flex-column">
                <h2 class="bh-section-title h4"><i class="bi bi-card-text"></i> Logs</h2>
                <div class="card main-site-card flex-fill p-2">

                    <div class="container rounded-3 p-2 mt-1"
                         style="background-color: #08081C; overflow-y: auto;">
                        @if (Output != null)
                        {
                            <pre class="text-white text-start"
                                 style="white-space: pre-wrap; max-height: 950px; margin: 0;">
                        @Output
                    </pre>
                        }
                        else
                        {
                            <pre class="text-white" style="white-space: pre-wrap; max-height: 950px; margin: 0;">There are no logs currently available...</pre>
                        }
                        <p class="text-white mt-5 text-start">Last Fetched: @ContainerFetchTime</p>
                    </div>
                </div>
            </div>
        </div>

        <h2 class="bh-section-title h4 mt-5">
            <i class="bi bi-box-seam"></i> Containers Running
            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined" Class="ml-2">
                @Containers.Count
            </MudChip>
        </h2>

        @* The dashboard's card, with the two actions that only belong here: pull a fresh image
           and read recent logs. Everything else about it is deliberately identical. *@
        <div class="row gy-3">
            @if (Containers.Count == 0)
            {
                <div class="col-12">
                    <div class="bh-empty">
                        <i class="bi bi-moon-stars"></i>
                        <div class="fw-bold mb-1">Nothing is running</div>
                        <div style="font-size: 0.85rem;">Start a container from the Commands panel above.</div>
                    </div>
                </div>
            }
            @foreach (var container in Containers.OrderBy(x => x.Image))
            {
                <div class="col-xl-4 col-md-6">
                    <div class="container-card h-100">
                        <div class="p-3">
                            <div class="d-flex align-items-start gap-3 mb-3">
                                <div class="bh-container-logo">
                                    <img src="@ContainerDisplay.IconUrl(container.Image)" alt="@ContainerDisplay.Name(container)"/>
                                </div>
                                <div class="flex-fill" style="min-width: 0;">
                                    <p class="bh-container-name">@ContainerDisplay.Name(container)</p>
                                    <span class="bh-status @ContainerDisplay.StatusModifier(container.Status) mt-1">
                                        <span class="bh-status__dot"></span>@container.Status
                                    </span>
                                </div>
                            </div>

                            <dl class="mb-3">
                                <div class="bh-meta">
                                    <dt>Image</dt>
                                    <dd>@container.Image</dd>
                                </div>
                                <div class="bh-meta">
                                    <dt>Container ID</dt>
                                    <dd>@container.ContainerId</dd>
                                </div>
                                <div class="bh-meta">
                                    <dt>Created</dt>
                                    <dd>@container.Created</dd>
                                </div>
                            </dl>

                            <div class="d-flex gap-2 align-items-center">
                                <MudButton Disabled="Locked"
                                           OnClick="() => RestartContainer(container.ContainerId)"
                                           Color="Color.Tertiary"
                                           Variant="Variant.Filled"
                                           Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.RestartAlt"
                                           FullWidth="true">
                                    Restart
                                </MudButton>
                                <MudButton Disabled="Locked"
                                           OnClick="() => StopContainer(container.ContainerId)"
                                           Color="Color.Error"
                                           Variant="Variant.Outlined"
                                           Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.Stop"
                                           FullWidth="true">
                                    Stop
                                </MudButton>
                                <MudIconButton Disabled="Locked"
                                               OnClick="() => PullImage(container.Image)"
                                               Size="Size.Small"
                                               Class="bh-card-action"
                                               aria-label="Pull the latest image"
                                               Icon="@Icons.Material.Filled.CloudDownload"/>
                                <MudIconButton Disabled="Locked"
                                               OnClick="() => LogContainer(container.ContainerId)"
                                               Size="Size.Small"
                                               Class="bh-card-action"
                                               aria-label="Show recent logs"
                                               Icon="@Icons.Material.Filled.Article"/>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
        <p class="bh-timestamp mt-3">
            <i class="bi bi-clock-history"></i> Last fetched: @ContainerFetchTime
        </p>
    </Authorized>
</AuthorizeView>