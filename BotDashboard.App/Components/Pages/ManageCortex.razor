@page "/manage/cortex"

<PageTitle>Manage Cortex</PageTitle>

<AuthorizeView>
    <Authorized>
        <MudContainer MaxWidth="MaxWidth.Small">
            @if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <MudAlert Severity="Severity.Error" Class="mb-4" Variant="Variant.Filled">
                    @ErrorMessage
                </MudAlert>
            }
            <MudCard Class="pa-6 main-site-card" Elevation="2">
                <div class="d-flex justify-center">
                    <MudIcon Icon="@Icons.Material.Filled.Storage" Color="Color.Tertiary"
                             Style="font-size: 6rem;"/>
                </div>
                <MudCardContent>
                    @* bh-status is the whole pill -- dot and label together -- not a dot to put a
                       label beside. Used as a bare span in a flex row it stretches into an empty
                       lozenge. *@
                    <div class="d-flex justify-center mb-4">
                        <span class="bh-status @StatusClass">
                            <span class="bh-status__dot"></span>
                            @StatusText
                        </span>
                    </div>

                    <MudStack Spacing="3">
                        @foreach (var row in Rows)
                        {
                            <MudPaper Class="pa-3" Elevation="1">
                                <MudText Typo="Typo.subtitle2" GutterBottom="true">
                                    @row.Key
                                </MudText>
                                <MudText Typo="Typo.body2">
                                    @row.Value
                                </MudText>
                            </MudPaper>
                        }
                    </MudStack>

                    <MudDivider Class="my-4"/>

                    <MudText Typo="Typo.subtitle2" GutterBottom="true">Settings</MudText>
                    <MudSwitch T="bool"
                               @bind-Value="AutoLoadData"
                               @bind-Value:after="OnAutoLoadChanged"
                               Color="Color.Primary"
                               Label="Auto Load Data"/>
                    <MudText Typo="Typo.caption" Class="bh-muted">
                        On, the Dashboard, Commands, Stats and this page fetch from Cortex the moment
                        they open. Off, they render straight away and wait to be asked.
                    </MudText>

                    <MudStack Spacing="2">
                        <MudButton Disabled="Locked" Class="mt-4" Variant="Variant.Filled"
                                   OnClick="GetStatus" Color="Color.Primary">
                            Refresh
                        </MudButton>
                    </MudStack>
                </MudCardContent>
            </MudCard>
        </MudContainer>
    </Authorized>
</AuthorizeView>
