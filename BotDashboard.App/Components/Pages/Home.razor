@page "/"
@using BotDashboard.App.Constants
@inject ISnackbar Snackbar

<PageTitle>Dashboard</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="logo-container d-flex align-items-center justify-content-center">
            <img src="imgs/Bot Harbor - Logo Resized.png" alt="Bot Harbor Logo" class="img-fluid"/>
        </div>

        <div class="row gy-3 mt-4">
            <div class="col-lg-6 d-flex flex-column">
                <h2 class="bh-section-title h4">
                    <i class="bi bi-command"></i> Commands
                </h2>
                <div class="main-site-card flex-fill">
                    <div class="p-4">
                        <div class="d-flex align-items-center gap-3 mb-4">
                            <div class="bh-container-logo">
                                <img src="imgs/Docker Logo.png" alt="Docker"/>
                            </div>
                            <div>
                                <div class="fw-bold">Docker fleet</div>
                                <div class="bh-muted" style="font-size: 0.8rem;">
                                    Acting on @Containers.Count running container@(Containers.Count == 1 ? "" : "s")
                                </div>
                            </div>
                        </div>

                        <div class="bh-muted mb-2" style="font-size: 0.68rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase;">
                            Fleet
                        </div>
                        <div class="d-flex flex-wrap gap-2 mb-4">
                            <MudButton Disabled="Locked"
                                       Color="Color.Primary"
                                       Variant="Variant.Filled"
                                       StartIcon="@Icons.Material.Filled.StopCircle"
                                       OnClick="StopAllContainers">
                                Stop All
                            </MudButton>

                            <MudButton Disabled="Locked"
                                       Color="Color.Primary"
                                       Variant="Variant.Filled"
                                       StartIcon="@Icons.Material.Filled.RestartAlt"
                                       OnClick="RestartAllContainers">
                                Restart All
                            </MudButton>

                            <MudButton Disabled="Locked"
                                       Color="Color.Primary"
                                       Variant="Variant.Outlined"
                                       StartIcon="@Icons.Material.Filled.Refresh"
                                       OnClick="() => ListContainers()">
                                Refresh Containers
                            </MudButton>

                            <MudButton Disabled="Locked"
                                       Color="Color.Primary"
                                       Variant="Variant.Outlined"
                                       StartIcon="@Icons.Material.Filled.Insights"
                                       OnClick="() => ListStats()">
                                Refresh Stats
                            </MudButton>
                        </div>

                        <div class="bh-muted mb-2" style="font-size: 0.68rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase;">
                            Launch a bot
                        </div>
                        <div class="d-flex flex-wrap gap-2">
                            <MudButton Disabled="Locked" Color="Color.Tertiary" Variant="Variant.Filled"
                                       StartIcon="@Icons.Material.Filled.PlayArrow"
                                       OnClick="() => RunImage(DockerRepository.JokeBot)">
                                JokeBot
                            </MudButton>

                            <MudButton Disabled="Locked" Color="Color.Tertiary" Variant="Variant.Filled"
                                       StartIcon="@Icons.Material.Filled.PlayArrow"
                                       OnClick="() => RunImage(DockerRepository.TriviaBot)">
                                TriviaBot
                            </MudButton>

                            <MudButton Disabled="Locked" Color="Color.Tertiary" Variant="Variant.Filled"
                                       StartIcon="@Icons.Material.Filled.PlayArrow"
                                       OnClick="() => RunImage(DockerRepository.FactBot)">
                                FactBot
                            </MudButton>

                            <MudButton Disabled="Locked" Color="Color.Tertiary" Variant="Variant.Filled"
                                       StartIcon="@Icons.Material.Filled.PlayArrow"
                                       OnClick="() => RunImage(DockerRepository.PremBot)">
                                PremBot
                            </MudButton>

                            <MudButton Disabled="Locked" Color="Color.Tertiary" Variant="Variant.Filled"
                                       StartIcon="@Icons.Material.Filled.PlayArrow"
                                       OnClick="() => RunImage(DockerRepository.JamJunction)">
                                JamJunction
                            </MudButton>

                            <MudButton Disabled="Locked" Color="Color.Tertiary" Variant="Variant.Filled"
                                       StartIcon="@Icons.Material.Filled.PlayArrow"
                                       OnClick="() => RunImage(DockerRepository.YtCipher)">
                                YouTube Cipher
                            </MudButton>
                        </div>

                        @if (Locked)
                        {
                            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mt-4" Rounded="true"/>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-6 d-flex flex-column">
                <h2 class="bh-section-title h4">
                    <i class="bi bi-activity"></i> Cortex Stats
                </h2>
                <div class="main-site-card flex-fill d-flex flex-column">
                    <div class="p-4">
                        <div class="bh-stat-row mb-3">
                            <div class="bh-stat">
                                <span class="bh-stat__label">Memory</span>
                                <span class="bh-stat__value bh-stat__value--accent">@Math.Round(MemoryUsagePercentage)%</span>
                            </div>
                            <div class="bh-stat">
                                <span class="bh-stat__label">CPU</span>
                                <span class="bh-stat__value bh-stat__value--accent">@Math.Round(CpuUsagePercentage)%</span>
                            </div>
                            <div class="bh-stat">
                                <span class="bh-stat__label">Containers</span>
                                <span class="bh-stat__value">@Containers.Count</span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-sm-6">
                                <div class="bh-donut">
                                <MudChart ChartType="ChartType.Donut"
                                          Width="225px"
                                          Height="225px"
                                          InputData="@MemoryUsageData"
                                          InputLabels="@MemoryUsageLabels">
                                    <CustomGraphics>
                                        <text class="donut-inner-text"
                                              x="50%"
                                              y="50%"
                                              dominant-baseline="middle"
                                              text-anchor="middle"
                                              fill="white"
                                              font-size="20">
                                            @Math.Round(MemoryUsagePercentage)%
                                        </text>
                                    </CustomGraphics>
                                </MudChart>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="bh-donut">
                                <MudChart ChartType="ChartType.Donut"
                                          Width="225px"
                                          Height="225px"
                                          InputData="@CpuUsageData"
                                          InputLabels="@CpuUsageLabels">
                                    <CustomGraphics>
                                        <text class="donut-inner-text"
                                              x="50%"
                                              y="50%"
                                              dominant-baseline="middle"
                                              text-anchor="middle"
                                              fill="white"
                                              font-size="20">
                                            @Math.Round(CpuUsagePercentage)%
                                        </text>
                                    </CustomGraphics>
                                </MudChart>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="mt-auto px-4 pb-3 text-center">
                        <p class="bh-timestamp">
                            <i class="bi bi-clock-history"></i> Last fetched: @StatFetchTime
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <h2 class="bh-section-title h4 mt-5">
            <i class="bi bi-box-seam"></i> Containers Running
            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined" Class="ml-2">
                @Containers.Count
            </MudChip>
        </h2>

        <div class="row gy-3">
            @if (Containers.Count == 0)
            {
                <div class="col-12">
                    <div class="bh-empty">
                        <i class="bi bi-moon-stars"></i>
                        <div class="fw-bold mb-1">Nothing is running</div>
                        <div style="font-size: 0.85rem;">Launch a bot from the Commands panel above.</div>
                    </div>
                </div>
            }
            @foreach (var container in Containers.OrderBy(x => x.Image))
            {
                <div class="col-xl-4 col-md-6">
                    <div class="container-card h-100">
                        <div class="p-3">
                            <div class="d-flex align-items-start gap-3 mb-3">
                                <div class="bh-container-logo">
                                    <img src="@ContainerIconUrl(container.Image)" alt="@container.Image"/>
                                </div>
                                <div class="flex-fill" style="min-width: 0;">
                                    <p class="bh-container-name">@FriendlyImageName(container.Image)</p>
                                    <span class="bh-status @StatusModifier(container.Status) mt-1">
                                        <span class="bh-status__dot"></span>@container.Status
                                    </span>
                                </div>
                            </div>

                            <dl class="mb-3">
                                <div class="bh-meta">
                                    <dt>Container ID</dt>
                                    <dd>@container.ContainerId</dd>
                                </div>
                                <div class="bh-meta">
                                    <dt>Created</dt>
                                    <dd>@container.Created</dd>
                                </div>
                            </dl>

                            <div class="d-flex gap-2">
                                <MudButton Disabled="Locked"
                                           OnClick="() => RestartContainer(container.ContainerId)"
                                           Color="Color.Tertiary"
                                           Variant="Variant.Filled"
                                           Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.RestartAlt"
                                           FullWidth="true">
                                    Restart
                                </MudButton>
                                <MudButton Disabled="Locked"
                                           OnClick="() => StopContainer(container.ContainerId)"
                                           Color="Color.Error"
                                           Variant="Variant.Outlined"
                                           Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.Stop"
                                           FullWidth="true">
                                    Stop
                                </MudButton>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <p class="bh-timestamp mt-3">
            <i class="bi bi-clock-history"></i> Last fetched: @ContainerFetchTime
        </p>
    </Authorized>
</AuthorizeView>
