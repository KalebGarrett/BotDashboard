@implements IDisposable

@inject NavigationManager NavigationManager

@* Drawer background and link styling come from BotHarborTheme and app.css. *@
<MudNavMenu Bordered="false" Rounded="true" Margin="Margin.Dense" Color="Color.Tertiary" Class="pa-3">
    <div class="d-flex justify-center py-2">
        <MudImage Width="160" Height="80" ObjectFit="ObjectFit.Contain"
                  Src="imgs/Bot Harbor - Landscape.png" Alt="Bot Harbor"/>
    </div>

    <MudDivider Class="my-3"/>

    <MudText Typo="Typo.overline" Class="bh-muted px-3">Overview</MudText>
    <MudNavLink IconColor="Color.Tertiary" Icon="@Icons.Material.Filled.Dashboard" Href=""
                Match="NavLinkMatch.All">Dashboard
    </MudNavLink>
    <MudNavLink IconColor="Color.Tertiary" Icon="@Icons.Material.Filled.KeyboardCommandKey" Href="commands"
                Match="NavLinkMatch.Prefix">Commands
    </MudNavLink>
    <MudNavLink IconColor="Color.Tertiary" Icon="@Icons.Material.Filled.QueryStats" Href="stats"
                Match="NavLinkMatch.Prefix">Stats
    </MudNavLink>

    <MudDivider Class="my-3"/>

    <MudText Typo="Typo.overline" Class="bh-muted px-3">Settings</MudText>
    <MudNavLink IconColor="Color.Tertiary" Icon="@Icons.Material.Filled.Waves" Href="/manage/droplet"
                Match="NavLinkMatch.Prefix">Manage Droplet
    </MudNavLink>
    <MudNavLink IconColor="Color.Tertiary" Icon="@Icons.Material.Filled.Password" Href="/manage/password"
                Match="NavLinkMatch.Prefix">Manage Password
    </MudNavLink>
</MudNavMenu>

@code {
    private string CurrentUrl { get; set; }

    protected override void OnInitialized()
    {
        CurrentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        CurrentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

}
