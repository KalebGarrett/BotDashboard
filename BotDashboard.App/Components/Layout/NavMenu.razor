@implements IDisposable

@inject NavigationManager NavigationManager

@* Drawer background and link styling come from BotHarborTheme and app.css. *@
<MudNavMenu Bordered="false" Rounded="true" Margin="Margin.Dense" Color="Color.Tertiary"
            Class="@(Open ? "pa-3" : "px-0 py-3")">
    @* Collapsed, the drawer is a narrow rail. The landscape wordmark is 160px wide and spilled
       out of it, which is where the horizontal scrollbar came from; the rail wears the square
       lighthouse mark instead. *@
    <div class="d-flex justify-center py-2">
        @if (Open)
        {
            <MudImage Width="160" Height="80" ObjectFit="ObjectFit.Contain"
                      Src="imgs/Bot Harbor - Landscape.png" Alt="Bot Harbor"/>
        }
        else
        {
            <MudImage Width="40" Height="40" ObjectFit="ObjectFit.Contain"
                      Src="imgs/Bot Harbor - Light House.png" Alt="Bot Harbor"/>
        }
    </div>

    <MudDivider Class="my-3"/>

    @* MudBlazor hides the link labels itself on a closed mini drawer, but section headings are
       plain text it knows nothing about, so they are ours to drop. *@
    @if (Open)
    {
        <MudText Typo="Typo.overline" Class="bh-muted px-3">Overview</MudText>
    }
    <MudNavLink IconColor="Color.Tertiary" Icon="@Icons.Material.Filled.Dashboard" Href=""
                Match="NavLinkMatch.All">Dashboard
    </MudNavLink>
    <MudNavLink IconColor="Color.Tertiary" Icon="@Icons.Material.Filled.KeyboardCommandKey" Href="commands"
                Match="NavLinkMatch.Prefix">Commands
    </MudNavLink>
    <MudNavLink IconColor="Color.Tertiary" Icon="@Icons.Material.Filled.QueryStats" Href="stats"
                Match="NavLinkMatch.Prefix">Stats
    </MudNavLink>

    <MudDivider Class="my-3"/>

    @if (Open)
    {
        <MudText Typo="Typo.overline" Class="bh-muted px-3">Settings</MudText>
    }
    <MudNavLink IconColor="Color.Tertiary" Icon="@Icons.Material.Filled.Storage" Href="/manage/cortex"
                Match="NavLinkMatch.Prefix">Manage Cortex
    </MudNavLink>
    <MudNavLink IconColor="Color.Tertiary" Icon="@Icons.Material.Filled.Waves" Href="/manage/droplet"
                Match="NavLinkMatch.Prefix">Manage Droplet
    </MudNavLink>
    <MudNavLink IconColor="Color.Tertiary" Icon="@Icons.Material.Filled.AlternateEmail" Href="/manage/email"
                Match="NavLinkMatch.Prefix">Manage Email
    </MudNavLink>
    <MudNavLink IconColor="Color.Tertiary" Icon="@Icons.Material.Filled.Password" Href="/manage/password"
                Match="NavLinkMatch.Prefix">Manage Password
    </MudNavLink>

    <MudDivider Class="my-3"/>

    @* The collapse control sits under the links rather than in the app bar, so the drawer
       owns its own chrome now that it runs the full height of the viewport. *@
    <div class="d-flex justify-center pb-2">
        <MudIconButton Class="bh-drawer-toggle"
                       Icon="@(Open ? Icons.Material.Filled.ArrowBackIos : Icons.Material.Filled.ArrowForwardIos)"
                       Size="Size.Small"
                       aria-label="@(Open ? "Collapse navigation" : "Expand navigation")"
                       OnClick="@(() => OnToggle.InvokeAsync())"/>
    </div>
</MudNavMenu>

@code {
    /// <summary>Whether the drawer is open, so the arrow can point the right way.</summary>
    [Parameter] public bool Open { get; set; }

    /// <summary>Raised when the collapse control is used; MainLayout owns the drawer state.</summary>
    [Parameter] public EventCallback OnToggle { get; set; }

    private string CurrentUrl { get; set; }

    protected override void OnInitialized()
    {
        CurrentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        CurrentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

}
