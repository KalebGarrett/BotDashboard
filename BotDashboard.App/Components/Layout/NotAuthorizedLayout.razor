@inherits LayoutComponentBase
@using BotDashboard.App.Theme

<MudThemeProvider Theme="BotHarborTheme.Instance" IsDarkMode="true"/>
<MudDialogProvider/>
<MudSnackbarProvider/>
<MudPopoverProvider/>

<MudLayout>
    @* No nav on the login screen, so the bar is just a thin branded strip. *@
    <MudAppBar Elevation="0" Dense="true">
        <MudText Typo="Typo.subtitle2" Class="bh-muted">Bot Harbor</MudText>
    </MudAppBar>
    <MudMainContent Class="d-flex flex-column" Style="min-height:100vh;">
        <article class="content px-4 flex-fill">
            @Body
        </article>
        <_Footer/>
    </MudMainContent>
</MudLayout>
