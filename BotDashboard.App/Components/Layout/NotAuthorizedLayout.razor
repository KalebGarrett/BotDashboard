@inherits LayoutComponentBase
@using BotDashboard.App.Theme

<MudThemeProvider Theme="BotHarborTheme.Instance" IsDarkMode="true"/>
<MudDialogProvider/>
<MudSnackbarProvider/>
<MudPopoverProvider/>

<MudLayout>
    @* No nav and no title on the login screen: the wordmark sits right below this, so a label
       here only repeats it. The bar stays for the gradient strip along the top. *@
    <MudAppBar Elevation="0" Dense="true"/>
    <MudMainContent Class="d-flex flex-column" Style="min-height:100vh;">
        <article class="content px-4 flex-fill">
            @Body
        </article>
        <_Footer/>
    </MudMainContent>
</MudLayout>
