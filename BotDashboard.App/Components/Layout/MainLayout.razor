@inherits LayoutComponentBase
@inject ISnackbar Snackbar
@using BotDashboard.App.Theme

<MudThemeProvider Theme="BotHarborTheme.Instance" IsDarkMode="true"/>
<MudDialogProvider/>
<MudSnackbarProvider/>
<MudPopoverProvider/>

<AuthorizeView>
    <Authorized>
        <MudLayout>
            @* Colours come from BotHarborTheme and the .mud-appbar rule in app.css. *@
            <MudAppBar Elevation="0">
                @* Only the small-screen toggle lives here. On desktop the collapse control sits at
                   the foot of the drawer, which runs full height. On a phone the drawer starts
                   closed, so a toggle inside it would be unreachable -- hence this one stays. *@
                <MudHidden Breakpoint="Breakpoint.MdAndUp">
                    <MudIconButton Class="text-white" Edge="Edge.Start"
                                   Icon="@Icons.Material.Filled.Menu"
                                   OnClick="@((e) => ToggleDrawer())"/>
                </MudHidden>
                <MudSpacer/>
                <MudHidden Breakpoint="Breakpoint.SmAndDown">
                    <MudText Typo="Typo.body2" Class="mr-3">@context.User.Identity?.Name</MudText>
                </MudHidden>
                <MudMenu DropShadow="true" AnchorOrigin="Origin.BottomRight">
                    <ActivatorContent>
                        <MudAvatar>
                            <MudImage Src="imgs/Bot Harbor - Light House.png" Alt="Bot Harbor Logo"/>
                        </MudAvatar>
                    </ActivatorContent>
                    <ChildContent>
                        <MudMenuItem OnClick="Logout" Icon="@Icons.Material.Filled.Logout">Logout</MudMenuItem>
                    </ChildContent>
                </MudMenu>
            </MudAppBar>
            @* Mini, not the default: collapsing shrinks the drawer to an icon rail instead of
               hiding it, so the toggle at its foot stays reachable. With the toggle living
               inside the drawer, a variant that hides it leaves no way to reopen it. *@
            <MudDrawer @bind-Open="@Open" Elevation="0" ClipMode="DrawerClipMode.Never"
                       Variant="DrawerVariant.Mini" OpenMiniOnHover="false">
                <NavMenu Open="Open" OnToggle="ToggleDrawer"/>
            </MudDrawer>
            <MudMainContent Class="d-flex flex-column" Style="min-height:100vh;">
                <article class="content px-4 flex-fill">
                    <ErrorBoundary @ref="ErrorBoundary">
                        <ChildContent>
                            @Body
                        </ChildContent>
                        <ErrorContent Context="errorContext">
                            @Body
                            @GetErrorContent()
                        </ErrorContent>
                    </ErrorBoundary>
                </article>
                <_Footer/>
            </MudMainContent>
        </MudLayout>
    </Authorized>
    <NotAuthorized>
        @{ NavigateToLogin(); }
    </NotAuthorized>
</AuthorizeView>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>