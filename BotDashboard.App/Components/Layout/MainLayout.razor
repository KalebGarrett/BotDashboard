@inherits LayoutComponentBase
@inject ISnackbar Snackbar
@using BotDashboard.App.Theme

<MudThemeProvider Theme="BotHarborTheme.Instance" IsDarkMode="true"/>
<MudDialogProvider/>
<MudSnackbarProvider/>
<MudPopoverProvider/>

<AuthorizeView>
    <Authorized>
        <MudLayout>
            @* Colours come from BotHarborTheme and the .mud-appbar rule in app.css. *@
            <MudAppBar Elevation="0">
                @* Only the small-screen toggle lives here. On desktop the collapse control sits at
                   the foot of the drawer, which runs full height. On a phone the drawer starts
                   closed, so a toggle inside it would be unreachable -- hence this one stays. *@
                <MudHidden Breakpoint="Breakpoint.MdAndUp">
                    <MudIconButton Class="text-white" Edge="Edge.Start"
                                   Icon="@Icons.Material.Filled.Menu"
                                   OnClick="@((e) => ToggleDrawer())"/>
                </MudHidden>
                <MudSpacer/>
                <MudHidden Breakpoint="Breakpoint.SmAndDown">
                    <MudText Typo="Typo.body2" Class="mr-3">@context.User.Identity?.Name</MudText>
                </MudHidden>

                @* The bell. Rows are filed by the snackbar decorator and by the state
                   reconcilers on the pages, so this only ever reads. *@
                <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight"
                         DropShadow="true" Class="mr-2">
                    <ActivatorContent>
                        <MudBadge Content="@UnreadCount" Visible="@(UnreadCount > 0)"
                                  Color="Color.Error" Overlap="true" Bordered="true">
                            <MudIconButton Class="text-white"
                                           Icon="@(UnreadCount > 0 ? Icons.Material.Filled.NotificationsActive : Icons.Material.Outlined.Notifications)"
                                           aria-label="Notifications"/>
                        </MudBadge>
                    </ActivatorContent>
                    <ChildContent>
                        <div class="bh-bell">
                            <div class="bh-bell__head">
                                <span class="fw-bold">Notifications</span>
                                <span class="bh-muted" style="font-size: 0.75rem;">
                                    @(UnreadCount > 0 ? $"{UnreadCount} unread" : "All caught up")
                                </span>
                            </div>

                            @if (Notifications.Count == 0)
                            {
                                <div class="bh-bell__empty bh-muted">Nothing to report.</div>
                            }
                            else
                            {
                                <div class="bh-bell__list">
                                    @foreach (var notification in Notifications)
                                    {
                                        <div class="bh-bell__row @(notification.Unread ? "bh-bell__row--unread" : "")">
                                            <span class="bh-bell__dot @LevelModifier(notification.Level)"></span>
                                            <div class="bh-bell__body">
                                                <div class="bh-bell__title">@notification.Title</div>
                                                <div class="bh-bell__message">@notification.Message</div>
                                                <div class="bh-bell__time">@Ago(notification.CreatedAt)</div>
                                            </div>
                                        </div>
                                    }
                                </div>

                                <div class="bh-bell__foot">
                                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                                               OnClick="MarkAllRead">
                                        Mark all read
                                    </MudButton>
                                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error"
                                               OnClick="ClearNotifications">
                                        Clear
                                    </MudButton>
                                </div>
                            }
                        </div>
                    </ChildContent>
                </MudMenu>
                <MudMenu DropShadow="true" AnchorOrigin="Origin.BottomRight">
                    <ActivatorContent>
                        <MudAvatar>
                            <MudImage Src="imgs/Bot Harbor - Light House.png" Alt="Bot Harbor Logo"/>
                        </MudAvatar>
                    </ActivatorContent>
                    <ChildContent>
                        <MudMenuItem OnClick="Logout" Icon="@Icons.Material.Filled.Logout">Logout</MudMenuItem>
                    </ChildContent>
                </MudMenu>
            </MudAppBar>
            @* Mini, not the default: collapsing shrinks the drawer to an icon rail instead of
               hiding it, so the toggle at its foot stays reachable. With the toggle living
               inside the drawer, a variant that hides it leaves no way to reopen it. *@
            <MudDrawer @bind-Open="@Open" Elevation="0" ClipMode="DrawerClipMode.Never"
                       Variant="DrawerVariant.Mini" OpenMiniOnHover="false" MiniWidth="72px">
                <NavMenu Open="Open" OnToggle="ToggleDrawer"/>
            </MudDrawer>
            <MudMainContent Class="d-flex flex-column" Style="min-height:100vh;">
                <article class="content px-4 flex-fill">
                    <ErrorBoundary @ref="ErrorBoundary">
                        <ChildContent>
                            @Body
                        </ChildContent>
                        <ErrorContent Context="errorContext">
                            @Body
                            @GetErrorContent()
                        </ErrorContent>
                    </ErrorBoundary>
                </article>
                <_Footer/>
            </MudMainContent>
        </MudLayout>
    </Authorized>
    <NotAuthorized>
        @{ NavigateToLogin(); }
    </NotAuthorized>
</AuthorizeView>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>